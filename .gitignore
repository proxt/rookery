# Build artifacts
/bin/
*.exe
*.dll
!client/gui/wintun/wintun.dll

# Real configs (examples are tracked, real ones are not)
panel/configs/panel.yaml
client/configs/client.yaml

# Wails / frontend — build/bin and build/windows/tasklist.json are real
# generated output; build/appicon.png, build/windows/icon.ico, and
# build/windows/wails.exe.manifest are source assets Wails reads, not output.
client/gui/build/bin/
client/gui/frontend/dist/
client/gui/frontend/node_modules/

# Panel admin frontend — built by the Docker image (see panel/Dockerfile);
# go:embed needs dist/ present for a non-Docker local build, so build it
# yourself first (npm install && npm run build in the frontend dir).
panel/internal/admin/frontend/dist/
panel/internal/admin/frontend/node_modules/

# Go
*.test
*.out

